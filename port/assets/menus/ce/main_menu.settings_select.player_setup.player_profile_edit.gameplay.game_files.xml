<?xml version="1.0" encoding="UTF-8"?>
<!-- The port's settings screen, in the PC version's style (tools/port_settings.py) -->
<menus>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/gameplay/game_files/screen" type="column_list" width="640" height="480" bitmap="bitmaps/gradient" flags="pass_unhandled_to_focused_child up_down_tabs_children">
		<on event="b" back="true"/>
		<on event="back" back="true"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/gameplay/game_files/description" x="40" y="80"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/gameplay/game_files/app" x="195" y="300"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/gameplay/game_files/other" x="195" y="340"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/gameplay/game_files/back" x="195" y="390"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/gameplay/game_files/title" x="40" y="24"/>
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/gameplay/game_files/title" type="text" width="560" height="40" text="GAME FILES" font="ui\large_ui" color="#FF2896FF">
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/gameplay/game_files/description" type="text" controller="1" width="560" height="210" font="ui\small_ui" color="#FFFFFFFF">
		<data input="port game files text"/>
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/gameplay/game_files/app" type="text" width="250" height="32" text="APP DATA" font="ui\large_ui" color="#FF2896FF" align="center">
		<on event="a" run="port game files app"/>
		<on event="start" run="port game files app"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/gameplay/game_files/other" type="text" width="250" height="32" text="OTHER FOLDER" font="ui\large_ui" color="#FF2896FF" align="center">
		<on event="a" run="port game files other"/>
		<on event="start" run="port game files other"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/gameplay/game_files/back" type="text" width="250" height="32" text="BACK" font="ui\large_ui" color="#FF2896FF" align="center">
		<on event="a" back="true"/>
		<on event="start" back="true"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</widget>
</menus>
